APP_NAME=Nuvora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nuvora
DB_USERNAME=nuvora
# Local Docker only. Do not reuse this password outside local development.
DB_PASSWORD=nuvora_local_dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nuvora.test"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173

NUVORA_DEFAULT_TIMEZONE=America/Bogota

FEATURE_RESERVATIONS=false
FEATURE_LPR=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_ADVANCED_REPORTS=false
FEATURE_AI_ASSISTANT=false
FEATURE_DYNAMIC_PRICING=false
FEATURE_ELECTRONIC_INVOICING=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_PROXY_TARGET=http://nginx
